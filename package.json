{
  "name": "minance-next",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @minance/web dev --port 3000",
    "dev:api": "env NODE_ENV=development PORT=3001 tsx services/api/src/server.ts",
    "build:web": "pnpm --filter @minance/web build",
    "start": "concurrently -k \"pnpm start:api\" \"pnpm start:web\"",
    "start:web": "pnpm --filter @minance/web start --port 3000",
    "start:api": "env NODE_ENV=production PORT=3001 tsx services/api/src/server.ts",
    "migrate:sqlite": "tsx scripts/migrate-json-to-sqlite.ts",
    "validate:sqlite": "tsx scripts/validate-json-vs-sqlite.ts",
    "seed:fixture": "tsx scripts/seed-deterministic-fixture.ts",
    "docs:api": "tsx scripts/generate-api-docs.ts",
    "guardrails": "tsx scripts/run-guardrails.ts",
    "test:test-first": "node --test scripts/check-root-script-binaries.test.mjs scripts/check-release-version.test.mjs && env NODE_ENV=test tsx --test scripts/check-frontend-test-first.test.ts && env NODE_ENV=test tsx --test scripts/run-with-open-ports.test.ts && env NODE_ENV=test tsx scripts/check-frontend-test-first.ts",
    "test": "pnpm test:test-first && env NODE_ENV=test tsx --test --test-concurrency=1 services/api/test/**/*.test.ts && pnpm --filter @minance/web test",
    "check": "pnpm guardrails && pnpm test",
    "e2e": "env NODE_ENV=test playwright test",
    "e2e:headed": "env NODE_ENV=test playwright test --project=chromium --headed",
    "e2e:ci": "env NODE_ENV=test playwright test --project=chromium",
    "e2e:a11y": "env NODE_ENV=test playwright test --project=chromium --grep @a11y",
    "test:ai-evals": "env AI_EVALS=1 tsx scripts/run-ai-evals.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "axe-core": "^4.12.1",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.1"
  },
  "dependencies": {
    "csv-parse": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "micromatch>picomatch": ">=2.3.2",
      "brace-expansion": ">=5.0.8",
      "minimatch>brace-expansion": ">=1.1.16",
      "js-yaml": ">=4.3.0",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "esbuild": ">=0.28.1",
      "@babel/core": ">=7.29.6 <8.0.0"
    }
  }
}
